                "summary": "2.3 Agregar un nuevo producto",
                "operationId": "785644b7d7dd38af4b51dafd0fbc1b6d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "sku",
                                    "name",
                                    "short_description",
                                    "long_description",
                                    "image",
                                    "net_price",
                                    "current_stock",
                                    "minimum_stock",
                                    "low_stock",
                                    "high_stock"
                                ],
                                "properties": {
                                    "sku": {
                                        "type": "string",
                                        "example": "AUD-050"
                                    },
                                    "name": {
                                        "type": "string",
                                        "example": "Audífonos inalámbricos"
                                    },
                                    "short_description": {
                                        "type": "string",
                                        "example": "Cancelación de ruido"
                                    },
                                    "long_description": {
                                        "type": "string",
                                        "example": "Audífonos over-ear con 30 h de batería y estuche de carga."
                                    },
                                    "image": {
                                        "description": "Ruta o URL de la única imagen del producto",
                                        "type": "string",
                                        "example": "images/logo.png"
                                    },
                                    "net_price": {
                                        "description": "Precio neto en CLP. El precio de venta se calcula solo (+19% IVA)",
                                        "type": "integer",
                                        "example": 59990
                                    },
                                    "current_stock": {
                                        "type": "integer",
                                        "example": 20
                                    },
                                    "minimum_stock": {
                                        "type": "integer",
                                        "example": 2
                                    },
                                    "low_stock": {
                                        "description": "Debe ser >= minimum_stock",
                                        "type": "integer",
                                        "example": 5
                                    },
                                    "high_stock": {
                                        "description": "Debe ser >= low_stock",
                                        "type": "integer",
                                        "example": 100
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Producto creado (incluye sale_price calculado)"
                    },
                    "422": {
                        "description": "Datos inválidos o vacíos"
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
